{
  "expo": {
    "name": "Expense Tracker",
    "slug": "fintracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fintracker",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Expense Tracker to access your photos to set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
