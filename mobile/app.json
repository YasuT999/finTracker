{
  "expo": {
    "name": "Expense Tracker",
    "slug": "fintracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fintracker",
    "newArchEnabled": true,
    "android": {
      "package": "com.fintracker.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Expense Tracker to access your photos to set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31c661ae-ca76-4dfe-bc67-c383bf34ca62"
      }
    },
    "owner": "yaswanth_999"
  }
}
